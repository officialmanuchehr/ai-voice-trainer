# База данных. SQLite-файл по умолчанию для локальной разработки.
# На Railway: вставь сюда сырой DATABASE_URL из плагина Postgres как есть
# (postgres://... или postgresql://...) — приложение само нормализует схему
# в postgresql+asyncpg:// (см. app/config.py). Код менять не нужно.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Выбор реализации провайдера. "stub" — заглушка (без внешних вызовов), для БЛОКА 0.
# Реальные значения появятся в следующих блоках: deepgram | deepseek | claude | elevenlabs.
STT_PROVIDER=stub
DIALOG_PROVIDER=stub
SCORING_PROVIDER=stub
TTS_PROVIDER=stub

# Ключи внешних сервисов. Заполняются позже, вручную, никогда не хардкодятся в коде.
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=
# Название модели DeepSeek (например, deepseek-chat). Оставь пустым для значения по умолчанию.
DEEPSEEK_MODEL=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Вход в приложение — по логину и паролю пользователя (роли, команды).
# SECRET_KEY подписывает cookie входа. Вне локальной SQLite — ОБЯЗАТЕЛЕН:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_HOURS=12

# Первый администратор создаётся при init_db, если такого логина ещё нет.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ТОЛЬКО для локальной разработки: демо-команда и по пользователю на каждую
# роль (manager1..3, lead1, trainer1, product1, compliance1, admin) с паролем
# DEMO_USERS_PASSWORD. Никогда не включать на реальном стенде.
SEED_DEMO_USERS=false
DEMO_USERS_PASSWORD=demo12345

# Необязательный внешний барьер HTTP Basic Auth поверх входа (кроме /health).
# Пусто = выключен. Вход пользователей работает и без него.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
